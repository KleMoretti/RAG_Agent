QWEN_API_KEY='sk-b8a94104572e44b181a7869611ad83a9'
# ==================== LLM Configuration ====================
# OpenAI/Qwen API密钥
OPENAI_API_KEY=sk-your-api-key-here

# LLM模型名称
LLM_MODEL=qwen-plus
# 或使用 OpenAI 模型
# LLM_MODEL=gpt-4o-mini

# LLM超时时间（秒）
LLM_TIMEOUT=30.0

# ==================== RAG Configuration ====================
# Embedding模型（使用Sentence Transformers）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# 向量索引路径
VECTOR_INDEX_PATH=./data/index/faiss.index

# 原始数据目录
DATA_DIR=./data/raw

# 检索Top-K结果数量
TOP_K=5

# 文本分块配置
MAX_CHUNK_TOKENS=350
CHUNK_OVERLAP=40

# ==================== RAG Timeout & Fallback ====================
# RAG超时时间（秒）
# 如果RAG检索+LLM调用超过此时间，将自动降级为直接使用LLM（不带RAG上下文）
# 建议设置为25秒（前端总超时60秒 - 25秒RAG = 35秒降级LLM余量）
RAG_TIMEOUT_SECONDS=25