# RAG_Agent Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# LLM API Configuration
# Use QWEN_API_KEY for Qwen models or OPENAI_API_KEY for OpenAI models
QWEN_API_KEY=your-qwen-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# LLM Model Configuration
# Default model to use (e.g., "qwen-plus", "gpt-4o-mini")
LLM_MODEL=qwen-plus

# Embedding Model Configuration
# Default: "all-MiniLM-L6-v2" (lightweight and fast)
# Alternatives: "all-mpnet-base-v2" (better quality), "moka-ai/m3e-base" (Chinese optimized)
EMBED_MODEL=all-MiniLM-L6-v2

# Database Configuration (if using MySQL backend)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/rag_agent?charset=utf8mb4

# JWT Secret Key (change this in production!)
# JWT_SECRET_KEY=your-secret-key-here

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
