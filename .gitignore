# .gitignore for RAG_Agent (Python / ML / RAG project)

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.env/
.venv/
venv/
env/
env.bak/
venv.bak/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints
.profile_default/
ipython_log.py

# Logs and runtime files
logs/
*.log
*.pid
*.seed
*.sqlite3

# Data, models, checkpoints, outputs
data/
datasets/
raw_data/
processed_data/
output/
outputs/
predictions/
models/
saved_models/
checkpoints/
checkpoint-*/
*.ckpt
*.pt
*.pth
*.bin
*.h5
*.onnx

# Experiment tracking & ML metadata
wandb/
mlruns/
.tensorboard/
tb_logs/
.neptune/

# Caches
.cache/
.cache_hf/
huggingface/
transformers_cache/
hf_home/
*.cache

# Secrets / credentials
.env
.env.*
credentials.json
service_account.json
*.pem
*.key
.secret/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Node (if present)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
.build/

# Docker
docker-compose.override.yml
*.log

# Misc
*.swp
*.tmp
*.bak
*~ 